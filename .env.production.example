APP_NAME=FOD Smart Toolbox API
APP_ENV=production

MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=esp_toolbox
MYSQL_USER=esp_user
MYSQL_PASSWORD=change-db-password
DATABASE_URL=mysql+pymysql://esp_user:change-db-password@mysql:3306/esp_toolbox?charset=utf8mb4

# 浏览器访问域名，例如 https://toolbox.example.com。没有域名时先填 http://服务器公网IP
CORS_ORIGINS=http://your-server-ip

# ESP32-P4 上传数据时必须带 HTTP Header: X-Device-Key
DEVICE_API_KEY=change-device-upload-key

# Admin login
ADMIN_USERNAME=10001
ADMIN_PASSWORD=wearethechampion
SECRET_KEY=031bcce07d5558c6ce195c92b84e59f34a9c1ebd76b78ff4256f34b12dd56078
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 默认 mock 可离线演示；接入乐鑫 AI Gateway/OpenAI-compatible 网关时再修改
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
